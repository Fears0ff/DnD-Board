{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hitDie": {
      "anyOf": [
        {
          "type": "number",
          "const": 6
        },
        {
          "type": "number",
          "const": 8
        },
        {
          "type": "number",
          "const": 10
        },
        {
          "type": "number",
          "const": 12
        }
      ]
    },
    "primaryAbility": {
      "default": "",
      "type": "string",
      "maxLength": 100
    },
    "savingThrows": {
      "default": [],
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "str",
          "dex",
          "con",
          "int",
          "wis",
          "cha"
        ]
      }
    },
    "subclasses": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 20000
    }
  },
  "required": [
    "hitDie"
  ],
  "description": "DnD Board compendium v1: class card data",
  "$id": "https://dnd-board.local/import-schemas/v1/class.json",
  "title": "DnD Board compendium class card (v1)"
}
