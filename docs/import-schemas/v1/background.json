{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "abilityScores": {
      "default": [],
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "str",
          "dex",
          "con",
          "int",
          "wis",
          "cha"
        ]
      }
    },
    "feat": {
      "default": "",
      "type": "string",
      "maxLength": 200
    },
    "skillProficiencies": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "toolProficiency": {
      "default": "",
      "type": "string",
      "maxLength": 200
    },
    "equipment": {
      "default": "",
      "type": "string",
      "maxLength": 2000
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 20000
    }
  },
  "description": "DnD Board compendium v1: background card data",
  "$id": "https://dnd-board.local/import-schemas/v1/background.json",
  "title": "DnD Board compendium background card (v1)"
}
