{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "size": {
      "type": "string",
      "enum": [
        "tiny",
        "small",
        "medium",
        "large",
        "huge",
        "gargantuan"
      ]
    },
    "creatureType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "alignment": {
      "default": "",
      "type": "string",
      "maxLength": 100
    },
    "armorClass": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "hitPoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "speed": {
      "default": "",
      "type": "string",
      "maxLength": 200
    },
    "abilities": {
      "type": "object",
      "properties": {
        "str": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "dex": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "con": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "int": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "wis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "cha": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      },
      "required": [
        "str",
        "dex",
        "con",
        "int",
        "wis",
        "cha"
      ]
    },
    "challengeRating": {
      "default": "",
      "type": "string",
      "maxLength": 10
    },
    "traits": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "text": {
            "default": "",
            "type": "string",
            "maxLength": 5000
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "actions": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "text": {
            "default": "",
            "type": "string",
            "maxLength": 5000
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 20000
    }
  },
  "required": [
    "size",
    "creatureType",
    "armorClass",
    "hitPoints",
    "abilities"
  ],
  "description": "DnD Board compendium v1: monster card data",
  "$id": "https://dnd-board.local/import-schemas/v1/monster.json",
  "title": "DnD Board compendium monster card (v1)"
}
