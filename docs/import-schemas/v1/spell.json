{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "school": {
      "type": "string",
      "enum": [
        "abjuration",
        "conjuration",
        "divination",
        "enchantment",
        "evocation",
        "illusion",
        "necromancy",
        "transmutation"
      ]
    },
    "castingTime": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "range": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "components": {
      "default": [],
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "verbal",
          "somatic",
          "material"
        ]
      }
    },
    "materialText": {
      "default": "",
      "type": "string",
      "maxLength": 500
    },
    "duration": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "concentration": {
      "default": false,
      "type": "boolean"
    },
    "ritual": {
      "default": false,
      "type": "boolean"
    },
    "classes": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "subclasses": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 20000
    },
    "higherLevels": {
      "default": "",
      "type": "string",
      "maxLength": 5000
    }
  },
  "required": [
    "level",
    "school",
    "castingTime",
    "range",
    "duration"
  ],
  "description": "DnD Board compendium v1: spell card data",
  "$id": "https://dnd-board.local/import-schemas/v1/spell.json",
  "title": "DnD Board compendium spell card (v1)"
}
